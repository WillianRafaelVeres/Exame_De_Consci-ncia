{
  "expo": {
    "name": "Custódia",
    "slug": "custodia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#11151A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.custodia.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#11151A"
      },
      "package": "com.custodia.app"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "scheme": "custodia",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f1e04b4b-38c7-4025-ac9c-acb8597f6028"
      }
    }
  }
}
